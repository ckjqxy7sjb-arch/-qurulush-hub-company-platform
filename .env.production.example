# Qurulush Hub company platform - production environment template
# Copy to a protected server-side env file and fill real values outside git/chat.

# First production administrator. After this user is created, demo accounts are disabled.
QH_BOOTSTRAP_ADMIN_EMAIL=owner@builder.kg
QH_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_16_PLUS_CHARS
QH_BOOTSTRAP_ADMIN_NAME="ФИО генерального директора"
QH_BOOTSTRAP_ADMIN_ROLE=ceo
QH_DISABLE_DEMO_USERS=1

# Strict production guard. The server refuses to start until all required gates pass.
QH_REQUIRE_PRODUCTION=1

# External hooks must return JSON with ok/status, not only exit code.
QH_REQUIRE_HOOK_JSON=1

# Maximum JSON API body. Keep this above base64 overhead for 10 MB document uploads.
QH_MAX_JSON_BYTES=16777216

# Official sacc2 / DGASK exchange.
QH_SACC2_API_URL=https://sacc2.avn.kg/api
QH_SACC2_API_KEY=CHANGE_ME_OFFICIAL_SACC2_KEY
QH_SACC2_SYNC_CMD="/opt/qurulush/bin/sync-sacc2 {payload}"
QH_SACC2_SYNC_TIMEOUT_SECONDS=30
QH_SACC2_STATUS_MAP={"needs_company":["needs_company","need_company_response"],"informed":["informed"],"review":["review","in_review"],"done":["done","completed"]}

# Electronic digital signature provider.
QH_EDS_PROVIDER=CHANGE_ME_EDS_PROVIDER
QH_EDS_API_URL=https://eds.provider.example/sign
QH_EDS_SIGN_CMD="/opt/qurulush/bin/sign-document {payload}"
QH_EDS_SIGN_TIMEOUT_SECONDS=30

# Payment confirmation for duties, fees, fines, and penalties.
QH_PAYMENT_GATEWAY_URL=https://payments.provider.example/api
QH_PAYMENT_GATEWAY_CMD="/opt/qurulush/bin/confirm-payment {payload}"
QH_PAYMENT_GATEWAY_TIMEOUT_SECONDS=30

# External document storage.
QH_STORAGE_MODE=external
QH_STORAGE_URL=s3://company-documents/qurulush-hub
QH_STORAGE_SYNC_CMD="aws s3 cp {file} {storage_url}/{doc_id}/"
QH_STORAGE_SYNC_TIMEOUT_SECONDS=60

# Antivirus check before saving uploaded construction documents.
QH_AV_SCANNER="/opt/qurulush/bin/scan-upload {file}"

# Local and remote SQLite backups.
QH_BACKUP_INTERVAL_MINUTES=60
QH_BACKUP_ON_START=1
QH_BACKUP_REMOTE_URL=s3://company-secure-backups/qurulush-hub
QH_BACKUP_REMOTE_CMD="/opt/qurulush/bin/sync-backup {backup} {manifest}"
QH_BACKUP_REMOTE_TIMEOUT_SECONDS=90

# Set only after lawyer/authorized specialist verifies current regulations, tariffs, forms, and deadlines.
QH_REFERENCE_VERIFIED_AT=YYYY-MM-DD
